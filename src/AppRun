#!/bin/sh
# Proton Drive AppImage entry point.
#   (no args)       -> the desktop app - what double-clicking runs
#   __sync-engine   -> the background folder-sync engine (used by the systemd
#                      user service the app installs on first run)
#   anything else   -> the upstream CLI, argv untouched (auth login, --help...)
#
# Everything the app needs travels inside: this project's Rust GUI in
# usr/bin, this project's Rust sync engine in usr/bin, and the unmodified
# upstream CLI in usr/bin. A host desktop needs nothing installed - only the
# usual FUSE + OpenGL, and a terminal emulator for the one-time Proton sign-in.

HERE="$(CDPATH='' cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)"
CLI="$HERE/usr/bin/proton-drive"
GUI="$HERE/usr/bin/proton-drive-gui"
ENGINE="$HERE/usr/bin/proton-engine"

if [ ! -x "$CLI" ]; then
    echo "proton-drive: payload missing from AppImage ($CLI)" >&2
    exit 127
fi

# No LD_LIBRARY_PATH exports here, on purpose: they would leak into every
# child process the app starts (xdg-open -> kde-open5, dolphin, the
# sign-in terminal...) and make those host apps load *our* libraries,
# which crashes them on a host running other versions.

case "${1:-}" in
    __sync-engine)
        shift
        PROTON_DRIVE_BIN="$CLI"
        if [ ! -x "$ENGINE" ]; then
            echo "proton-engine: missing from AppImage ($ENGINE)" >&2
            exit 127
        fi
        exec "$ENGINE" --loop "$@"
        ;;
    # __gui is explicit; "" is double-click; --smoke is the offscreen
    # start-up self-test the updater runs on a freshly downloaded build
    # (verify_staged_build) - it must reach the GUI, not the CLI.
    __gui|--smoke|"")
        if [ ! -x "$GUI" ]; then
            echo "GUI missing from AppImage ($GUI)" >&2
            exit 127
        fi
        exec "$GUI" "$@"
        ;;
    *)
        exec "$CLI" "$@"
        ;;
esac
